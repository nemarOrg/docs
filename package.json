{
  "name": "nemar-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "sh scripts/ensure-full-history.sh && bun run scripts/check-admin-gating.ts && astro build",
    "test": "bun test",
    "probe:gate": "bun run scripts/probe-admin-gate.ts",
    "preview": "astro preview",
    "astro": "astro",
    "gen:commands": "bun run scripts/generate-commands.ts",
    "deploy": "bun run build && wrangler deploy",
    "preview:worker": "bun run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "astro": "^6.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "starlight-links-validator": "0.24.0",
    "wrangler": "^4.98.0"
  }
}
